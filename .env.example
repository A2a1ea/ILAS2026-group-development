# Keep this file free of real secrets.
# OpenAI API keys must never be placed in browser-side code.
# If an OpenAI-backed feature is added later, load OPENAI_API_KEY only on a server.
OPENAI_API_KEY=

# Optional shared ranking storage through Supabase REST.
# Use a server-side key only; never expose SUPABASE_SERVICE_ROLE_KEY in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RANKING_TABLE=rankings
